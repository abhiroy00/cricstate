ENV=development

DATABASE_URL=postgresql+asyncpg://cricstate:cricstate@localhost:5432/cricstate
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Optional: creates a SUPER_ADMIN user on `python scripts/seed.py` when all three are set
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_USERNAME=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# --- Added in later phases, listed here so the shape is known upfront ---
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# AWS_BUCKET=
# AWS_REGION=
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# PAYMENT_KEY=
# PAYMENT_SECRET=
# Payment provider seam: "test" (default, fully local) or a real gateway name.
# PAYMENT_PROVIDER=test
# Webhook signature secret — when set, /webhooks/payments requires a valid
# HMAC-SHA256 signature; when empty, only explicit test webhooks are accepted.
# PAYMENT_WEBHOOK_SECRET=
# STREAMING_SERVER_URL=
# STREAMING_SECRET=
# CDN_URL=
