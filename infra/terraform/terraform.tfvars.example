# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored —
# never commit it (it will contain your real SSH public key and, if you
# leave it at the default, your budget alert email).

ssh_public_key = "ssh-ed25519 AAAA... your-public-key-here"

# Optional — tighten this to "<your-ip>/32" after the box is up. Left open
# by default because your IP isn't known ahead of time.
# allowed_ssh_cidr = "203.0.113.4/32"

# Optional — get a monthly email if AWS spend crosses 80% of this many USD.
# budget_alert_email = "you@example.com"
