{
  "expo": {
    "name": "CricState",
    "slug": "cricstate",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EA580C"
    },
    "android": {
      "package": "com.cricstate.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EA580C"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cricstate.app"
    },
    "extra": {
      "eas": {
        "projectId": "d997c0e4-8938-45e4-8e3b-26640ed0c19c"
      }
    },
    "owner": "abhiroy",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
